package game

// Made by tools/gen_data from data/text/*.json: do not edit; edit those files.

Language :: enum u8 {
	English,
	Polish,
}

// How the menu names each language, in itself.
LANGUAGE_NAME := [Language]cstring {
	.English = "ENGLISH",
	.Polish = "POLSKI",
}

// The name of each language's file, as the saved settings keep it.
LANGUAGE_CODE := [Language]string {
	.English = "en",
	.Polish = "pl",
}

