		station_label = #partial [Station_Kind]cstring{.Oven = "OVEN", .Fire = "FIRE", .Churn = "CHURN", .Bench = "WORKBENCH", .Camp = "CAMPFIRE"},
		station_about = #partial [Station_Kind]cstring{.Oven = "The better the baker, the richer the bake", .Fire = "The better the cook, the richer the dish", .Churn = "The better the dairy pig, the more butter and cheese", .Bench = "Wood from the forest, made into useful things.", .Camp = "The better the cook, the richer the dish"},
		station_busy = #partial [Station_Kind]cstring{.Oven = "BAKING... {seconds}", .Fire = "COOKING... {seconds}", .Churn = "CHURNING... {seconds}", .Bench = "BUILDING... {seconds}", .Camp = "COOKING... {seconds}"},
		cook_title = #partial [Station_Kind][4]cstring{.Oven = [4]cstring{"Beginner baker", "Apprentice baker", "Baker", "Master baker"}, .Fire = [4]cstring{"Beginner cook", "Apprentice cook", "Cook", "Master of the grill"}, .Camp = [4]cstring{"Beginner cook", "Apprentice cook", "Cook", "Master of the grill"}, .Churn = [4]cstring{"Beginner dairy pig", "Apprentice dairy pig", "Dairy pig", "Master cheesemaker"}, .Bench = [4]cstring{}},
		station_start = #partial [Station_Kind]cstring{.Oven = "Into the oven it goes!", .Fire = "On the fire it goes!", .Churn = "Round and round goes the churn!", .Bench = "Saw, saw... knock, knock!", .Camp = "On my campfire it goes!"},
		station_wait = #partial [Station_Kind]cstring{.Oven = "Still baking... it smells so good!", .Fire = "Still sizzling... not yet!", .Churn = "Still churning... round and round!", .Bench = "Not finished... one more nail!", .Camp = "Still sizzling... not yet!"},
