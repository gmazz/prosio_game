// The texts, in each language.
TEXTS := [Language]Text {
	.English = {
		decimal_point = ".",
		item_name = #partial [Item]cstring{.Apple = "APPLE", .Berries = "BERRIES", .Mushroom = "MUSHROOM", .Pumpkin = "PUMPKIN", .Cabbage = "CABBAGE", .Nuts = "NUTS", .Wheat = "WHEAT", .Egg = "EGG", .Flour = "FLOUR", .Salt = "ROCK SALT", .Fish = "RAW FISH", .Meat = "RAW MEAT", .Milk = "MILK", .Honey = "HONEY", .Pebble = "PEBBLE", .Apple_Pie = "APPLE PIE", .Pumpkin_Pie = "PUMPKIN PIE", .Berry_Muffins = "BERRY MUFFINS", .Mushroom_Pie = "MUSHROOM PIE", .Nut_Cake = "NUT CAKE", .Bread = "BREAD", .Fried_Egg = "FRIED EGG", .Grilled_Fish = "GRILLED FISH", .Roast = "ROAST MEAT", .Butter = "BUTTER", .Cheese = "CHEESE", .Wood = "WOOD", .Fence = "FENCE PIECE", .Scarecrow = "SCARECROW", .Rod = "FISHING ROD", .Spear = "SPEAR", .Gate = "GATE", .Larder = "LARDER", .Campfire = "CAMPFIRE KIT"},
		gather_text = #partial [Item]cstring{.Apple = "An apple for the sack!", .Berries = "Berries for the sack!", .Mushroom = "A mushroom for the sack!", .Pumpkin = "A pumpkin for the sack!", .Cabbage = "A cabbage for the sack!", .Nuts = "Nuts for the sack!", .Salt = "A lump of salt for the sack!", .Honey = "Honey for the sack!", .Pebble = "Pebbles! Good for throwing.", .Wheat = "Wheat for the sack!", .Egg = "An egg for the sack!", .Wood = "A good dry branch for the sack!", .Spear = "Got my spear back!"},
		eat_text = #partial [Item]cstring{.Apple = "Crunch! Yum!", .Berries = "Berries! Yum!", .Mushroom = "Mmm, mushroom!", .Pumpkin = "A whole pumpkin! Burp!", .Cabbage = "Crunch crunch... cabbage!", .Nuts = "Crack! Nutty nuts!", .Salt = "Lick, lick... SO salty!", .Fish = "Raw fish? Blergh! The fire by the pond grills it.", .Meat = "Raw meat? No! The fire by the pond roasts it.", .Milk = "Glug glug... creamy milk!", .Honey = "Sticky, sweet honey! Mmm!", .Pebble = "I can't eat a pebble! Hold {Grab} to throw one.", .Wheat = "I can't eat raw wheat! The mill makes flour of it.", .Egg = "A raw egg? Yuck! The fire by the pond fries it.", .Flour = "Dry flour? Blergh! It wants baking.", .Apple_Pie = "Apple pie! Heavenly!", .Pumpkin_Pie = "Pumpkin pie! BURP!", .Berry_Muffins = "Muffins! So fluffy!", .Mushroom_Pie = "Mushroom pie! Mmm!", .Nut_Cake = "Nut cake! So rich!", .Fried_Egg = "A fried egg! Sunny side up!", .Grilled_Fish = "Grilled fish! Crispy!", .Roast = "Roast meat! What a feast!", .Butter = "A whole pat of butter! Slurp!", .Cheese = "Cheese! Squeaky and salty!", .Bread = "Warm bread! Yum!", .Wood = "I can't eat wood! It is for fires, and for building.", .Fence = "No room for a fence here!", .Scarecrow = "No room for a scarecrow here!", .Rod = "My fishing rod! {Grab} at the pond casts it.", .Spear = "My spear! Hold {Grab} to throw it.", .Gate = "A gate! {Eat} puts it up in a fence.", .Larder = "A larder! {Eat} stands it up.", .Campfire = "My campfire kit! {Eat} sets it up."},
		plan_about = #partial [Item]cstring{.Fence = "{Eat} puts it up. Animals stay in... or out.", .Scarecrow = "{Eat} stands it up. Crows keep off the wheat.", .Rod = "{Grab} at the pond: fish from far, no fright.", .Spear = "Hold {Grab}: throw it. {Action} picks it up again.", .Gate = "{Eat} puts it up in a fence. {Action} opens it.", .Larder = "{Eat} stands it up. Food keeps 5 times longer.", .Campfire = "{Eat} sets it up: cook and chop meat anywhere."},
		thing_about = #partial [Item]cstring{.Pebble = "For throwing: choose it, then hold {Grab} and let go", .Wood = "For the oven, the cooking fire and the workbench", .Fence = "{Eat} puts it up in front of you. {Grab} takes it down again", .Scarecrow = "{Eat} stands it up. Crows keep off the wheat near it", .Rod = "Choose it, then {Grab} at the pond: fish from far off", .Spear = "Choose it, then hold {Grab} and let go. {Action} picks it up again", .Gate = "{Eat} puts it up like a fence. {Action} opens and shuts it, even holding an animal", .Larder = "{Eat} stands it up. {Action} opens it: food keeps 5 times longer in it", .Campfire = "{Eat} sets it up: a fire to cook eggs, fish and meat at, and to chop meat. {Grab} packs it up again"},
		station_name = #partial [Station_Kind]cstring{.Oven = "THE OVEN", .Fire = "THE COOKING FIRE", .Churn = "THE CHURN", .Bench = "THE WORKBENCH", .Camp = "MY CAMPFIRE"},
		station_label = #partial [Station_Kind]cstring{.Oven = "OVEN", .Fire = "FIRE", .Churn = "CHURN", .Bench = "WORKBENCH", .Camp = "CAMPFIRE"},
		station_about = #partial [Station_Kind]cstring{.Oven = "The better the baker, the richer the bake", .Fire = "The better the cook, the richer the dish", .Churn = "The better the dairy pig, the more butter and cheese", .Bench = "Wood from the forest, made into useful things.", .Camp = "The better the cook, the richer the dish"},
		station_busy = #partial [Station_Kind]cstring{.Oven = "BAKING... {seconds}", .Fire = "COOKING... {seconds}", .Churn = "CHURNING... {seconds}", .Bench = "BUILDING... {seconds}", .Camp = "COOKING... {seconds}"},
		cook_title = #partial [Station_Kind][4]cstring{.Oven = [4]cstring{"Beginner baker", "Apprentice baker", "Baker", "Master baker"}, .Fire = [4]cstring{"Beginner cook", "Apprentice cook", "Cook", "Master of the grill"}, .Camp = [4]cstring{"Beginner cook", "Apprentice cook", "Cook", "Master of the grill"}, .Churn = [4]cstring{"Beginner dairy pig", "Apprentice dairy pig", "Dairy pig", "Master cheesemaker"}, .Bench = [4]cstring{}},
		station_start = #partial [Station_Kind]cstring{.Oven = "Into the oven it goes!", .Fire = "On the fire it goes!", .Churn = "Round and round goes the churn!", .Bench = "Saw, saw... knock, knock!", .Camp = "On my campfire it goes!"},
		station_wait = #partial [Station_Kind]cstring{.Oven = "Still baking... it smells so good!", .Fire = "Still sizzling... not yet!", .Churn = "Still churning... round and round!", .Bench = "Not finished... one more nail!", .Camp = "Still sizzling... not yet!"},
		station_done = #partial [Station_Kind]cstring{.Oven = "Ding! The oven is ready!", .Fire = "Sizzle! It's cooked!", .Churn = "The churn is done!", .Bench = "There! All built!", .Camp = "Sizzle! It's cooked!"},
		station_take = #partial [Station_Kind]cstring{.Oven = "Into the sack, still warm!", .Fire = "Into the sack, still warm!", .Churn = "Into the sack, fresh from the churn!", .Bench = "Into the sack! I made that!", .Camp = "Into the sack, still warm!"},
		cook_bonus_line = "{title}: +{percent}% kcal   (up to +{most}%, the more you make)",
		kcal = "{kcal} kcal",
		raw_kcal = "(raw {kcal})",
		times = "x {count}",
		not_enough = "Not enough in the sack for that!",
		not_enough_wood = "Not enough in the sack for that! (A fire needs wood: branches lie under the forest trees.)",
		station_help = "UP / DOWN: choose     LEFT / RIGHT: how many     {Action}: make it     {Close}: close",
		need_name = #partial [Need]cstring{.Carbs = "CARBS", .Protein = "PROTEIN", .Fibre = "FIBRE", .Water = "WATER", .Vitamins = "VITAMINS", .Electrolytes = "ELECTROLYTES"},
		nutrient_name = #partial [Nutrient]cstring{.Carbs = "CARBS", .Fat = "FAT", .Protein = "PROTEIN", .Fibre = "FIBRE", .Vitamins = "VITAMINS", .Electrolytes = "ELECTROLYTES"},
		say_low = #partial [Need]cstring{.Carbs = "No fuel... I need bread, honey or fruit.", .Protein = "My muscles are wasting... I need eggs, fish or meat.", .Fibre = "Ooh, my tummy... I need cabbage or pumpkin.", .Water = "So thirsty... the pond is up the north-west path!", .Vitamins = "It's getting dim... I need berries or greens.", .Electrolytes = "Cramps... I need some rock salt."},
		say_empty = #partial [Need]cstring{.Carbs = "Running on fat alone! Bread, honey or fruit!", .Protein = "No protein left! Eggs, fish or meat!", .Fibre = "My tummy is in knots! Cabbage, quick!", .Water = "I'm drying out! Water, now!", .Vitamins = "I can hardly see! Berries, quick!", .Electrolytes = "Everything is cramping! Salt, quick!"},
		say_high = #partial [Need]cstring{.Carbs = "Wheee! Sugar rush!", .Protein = "Full of protein! Now to build some muscle!", .Fibre = "Uh oh... I feel gassy!", .Vitamins = "I can see for miles!", .Electrolytes = "I'm so salty... and so thirsty!"},
		say_over = #partial [Need]cstring{.Carbs = "Hic! Too much sugar! Hic! It's turning to fat!", .Protein = "Too much protein! I'm stiff as a board!", .Fibre = "Too much fibre! Stand back, everybody!", .Vitamins = "So many vitamins... I'm glowing orange!", .Electrolytes = "Too much salt! Water! WATER!"},
		low_name = #partial [Need]cstring{.Carbs = "NO FUEL", .Protein = "WASTING", .Fibre = "TUMMY ACHE", .Water = "THIRSTY", .Vitamins = "DIM EYES", .Electrolytes = "CRAMPS"},
