package game

// Made by tools/gen_data from the values marked "tune" in data/tuning/*.json: do not edit.

when WORKBENCH {
	Tunable :: struct {
		name, file, key, panes, about: string,
		value:                         ^f32,
		range:                         [2]f32,
		has_range:                     bool,
	}

	tunables :: proc() -> []Tunable {
		@(static) list: [178]Tunable
		list = {
			{"BUMP_GAIN", "animals", "", "attacks", "A bump hits with Prosio's momentum: his weight times his speed. An enemy digs in and soaks up the first part of that (its grip); only what is left over throws it: launch speed = BUMP_GAIN * (weight * speed - grip) / enemy's weight So a lean Prosio just bounces off, and the throw grows quickly with weight.", &BUMP_GAIN, {0, 0}, false},
			{"ENEMY_GRIP", "animals", "Turkey", "attacks", "its grip in the bump above: how much of his momentum (kg times m/s) it soaks up before it moves at all; raise it and a bump throws it less", &ENEMY_GRIP[.Turkey], {0, 0}, false},
			{"ENEMY_GRIP", "animals", "Goat", "attacks", "its grip in the bump above: how much of his momentum (kg times m/s) it soaks up before it moves at all; raise it and a bump throws it less", &ENEMY_GRIP[.Goat], {0, 0}, false},
			{"ENEMY_GRIP", "animals", "Billy", "attacks", "its grip in the bump above: how much of his momentum (kg times m/s) it soaks up before it moves at all; raise it and a bump throws it less", &ENEMY_GRIP[.Billy], {0, 0}, false},
			{"ENEMY_GRIP", "animals", "Fox", "attacks", "its grip in the bump above: how much of his momentum (kg times m/s) it soaks up before it moves at all; raise it and a bump throws it less", &ENEMY_GRIP[.Fox], {0, 0}, false},
			{"BLOW_TAKES", "animals", "", "attacks", "joules, for each kilogram of an animal, of a blow with BLOW_FACTOR 1 that take all its health. Raise it and every animal is harder to hurt, by every blow alike", &BLOW_TAKES, {0, 0}, false},
			{"ENEMY_TOUGH", "animals", "Turkey", "attacks", "what each kind can take, as a share of BLOW_TAKES times its weight, against every kind of blow: a goat and the billy goat take less for their weight than a turkey, so that a stomp takes as much from a goat as from a turkey and two thirds as much from the billy goat. Raise one and that kind is harder to hurt by everything", &ENEMY_TOUGH[.Turkey], {0, 0}, false},
			{"ENEMY_TOUGH", "animals", "Goat", "attacks", "what each kind can take, as a share of BLOW_TAKES times its weight, against every kind of blow: a goat and the billy goat take less for their weight than a turkey, so that a stomp takes as much from a goat as from a turkey and two thirds as much from the billy goat. Raise one and that kind is harder to hurt by everything", &ENEMY_TOUGH[.Goat], {0, 0}, false},
			{"ENEMY_TOUGH", "animals", "Billy", "attacks", "what each kind can take, as a share of BLOW_TAKES times its weight, against every kind of blow: a goat and the billy goat take less for their weight than a turkey, so that a stomp takes as much from a goat as from a turkey and two thirds as much from the billy goat. Raise one and that kind is harder to hurt by everything", &ENEMY_TOUGH[.Billy], {0, 0}, false},
			{"ENEMY_TOUGH", "animals", "Fox", "attacks", "what each kind can take, as a share of BLOW_TAKES times its weight, against every kind of blow: a goat and the billy goat take less for their weight than a turkey, so that a stomp takes as much from a goat as from a turkey and two thirds as much from the billy goat. Raise one and that kind is harder to hurt by everything", &ENEMY_TOUGH[.Fox], {0, 0}, false},
			{"ENEMY_HIDE", "animals", "Turkey", "attacks", "the share of a spear's harm that gets through each kind's hide: a goat's coat and the billy goat's thick hide turn some of it. Set so that an ordinary Prosio (80 kg) brings down a turkey with four spears, a goat or a fox with five and the billy goat with eight. Lower one and spears do less to that kind, and nothing else changes", &ENEMY_HIDE[.Turkey], {0, 0}, false},
			{"ENEMY_HIDE", "animals", "Goat", "attacks", "the share of a spear's harm that gets through each kind's hide: a goat's coat and the billy goat's thick hide turn some of it. Set so that an ordinary Prosio (80 kg) brings down a turkey with four spears, a goat or a fox with five and the billy goat with eight. Lower one and spears do less to that kind, and nothing else changes", &ENEMY_HIDE[.Goat], {0, 0}, false},
			{"ENEMY_HIDE", "animals", "Billy", "attacks", "the share of a spear's harm that gets through each kind's hide: a goat's coat and the billy goat's thick hide turn some of it. Set so that an ordinary Prosio (80 kg) brings down a turkey with four spears, a goat or a fox with five and the billy goat with eight. Lower one and spears do less to that kind, and nothing else changes", &ENEMY_HIDE[.Billy], {0, 0}, false},
			{"ENEMY_HIDE", "animals", "Fox", "attacks", "the share of a spear's harm that gets through each kind's hide: a goat's coat and the billy goat's thick hide turn some of it. Set so that an ordinary Prosio (80 kg) brings down a turkey with four spears, a goat or a fox with five and the billy goat with eight. Lower one and spears do less to that kind, and nothing else changes", &ENEMY_HIDE[.Fox], {0, 0}, false},
			{"BLOW_FACTOR", "animals", "Soft", "attacks", "how much of a blow's energy harms, by its kind: soft (his belly in a bump, a thrown or bashed animal, one animal into another: they give, and spread it), hard (his hooves in a stomp, a stone, a rock) and sharp (a spear: it puts it all into a small place, and goes deep). Soft: a bump or a bash takes a quarter of what it took before the blows went by energy. Hard: a 2 kg stone takes about a tenth of a turkey, a stomp about a tenth, and the heaviest rock an ordinary Prosio lifts (40 kg) a seventh (a third with STONE_MOMENTUM_SHARE at 0.5). Sharp: a spear at ARM_SPEED takes about 28 in a hundred of a turkey's health. Raise one and every blow of that kind harms more", &BLOW_FACTOR[.Soft], {0, 0}, false},
			{"BLOW_FACTOR", "animals", "Hard", "attacks", "how much of a blow's energy harms, by its kind: soft (his belly in a bump, a thrown or bashed animal, one animal into another: they give, and spread it), hard (his hooves in a stomp, a stone, a rock) and sharp (a spear: it puts it all into a small place, and goes deep). Soft: a bump or a bash takes a quarter of what it took before the blows went by energy. Hard: a 2 kg stone takes about a tenth of a turkey, a stomp about a tenth, and the heaviest rock an ordinary Prosio lifts (40 kg) a seventh (a third with STONE_MOMENTUM_SHARE at 0.5). Sharp: a spear at ARM_SPEED takes about 28 in a hundred of a turkey's health. Raise one and every blow of that kind harms more", &BLOW_FACTOR[.Hard], {0, 0}, false},
			{"BLOW_FACTOR", "animals", "Sharp", "attacks", "how much of a blow's energy harms, by its kind: soft (his belly in a bump, a thrown or bashed animal, one animal into another: they give, and spread it), hard (his hooves in a stomp, a stone, a rock) and sharp (a spear: it puts it all into a small place, and goes deep). Soft: a bump or a bash takes a quarter of what it took before the blows went by energy. Hard: a 2 kg stone takes about a tenth of a turkey, a stomp about a tenth, and the heaviest rock an ordinary Prosio lifts (40 kg) a seventh (a third with STONE_MOMENTUM_SHARE at 0.5). Sharp: a spear at ARM_SPEED takes about 28 in a hundred of a turkey's health. Raise one and every blow of that kind harms more", &BLOW_FACTOR[.Sharp], {0, 0}, false},
			{"STONE_MOMENTUM_SHARE", "animals", "", "attacks", "the share of a stone's or a rock's harm that goes by its momentum instead of its energy: the joules that count are (1 - share) times half its mass times its speed squared, plus share times its mass times its speed times ARM_SPEED / 2. At 0 a stone harms by its energy alone, as physics has it, and a heavy rock, which he can only lob slowly, does little; at 1 by its momentum alone. A stone thrown at ARM_SPEED harms the same at any share. It starts at 0, as Gio set it. Raise it and heavy, slow rocks harm more", &STONE_MOMENTUM_SHARE, {0, 1}, true},
			{"FALL_GRAVITY", "animals", "", "attacks", "m/s each second: the gravity the energy of a fall is counted with, in a stomp and in a stone or a rock that comes down on an animal. The things in the meadow fall faster (GRAVITY in world.json, 25, so that jumps are snappy), which would give every fall two and a half times its real energy, while throws are at real-world strength (THROW_ENERGY): this keeps the two at the same scale. Raise it and stomps and dropped rocks harm more", &FALL_GRAVITY, {0, 30}, true},
			{"HEAL_RATE", "animals", "", "attacks", "health it mends each second at the most, once HEAL_RAMP seconds have gone by since it was last hurt: from nothing to whole in 30 seconds at that speed. Raise it and animals mend faster", &HEAL_RATE, {0, 0}, false},
			{"HEAL_RAMP", "animals", "", "attacks", "seconds after a blow until it mends at the full HEAL_RATE: it starts mending at once, at a speed that grows with the time since it was last hurt (2 seconds after a hit it has mended 0.3 in a hundred, after 10 seconds 8, after 20 seconds 33). So blows close together keep it from mending, and one that gets away mends quickly. Raise it and an animal mends more slowly after each blow", &HEAL_RAMP, {0, 0}, false},
			{"STOMP_SINK", "animals", "", "attacks", "metres. Prosio comes down on an animal: the energy of the blow is his weight (with what he carries) times FALL_GRAVITY times the height he came down from (the top of his jump), and STOMP_SINK more metres, as he goes on pressing while he sinks into it. A stone or a rock coming down on an animal presses on the same way. A jump puts the same energy into him whatever he weighs (by his legs: see JUMP_ENERGY in prosio.json), so it is the sinking that makes a heavier Prosio stomp harder with the same legs, and stronger legs jump higher and stomp harder. Raise it and every stomp harms more, a heavy Prosio's most", &STOMP_SINK, {0, 0}, false},
			{"STOMP_PIN", "animals", "", "attacks", "seconds an animal he stomps on stays flattened for each unit of his momentum as he lands (kg times m/s, his weight times his falling speed, as fast as he really falls, by GRAVITY): an ordinary Prosio pins one for about 2 seconds, a heavier one longer", &STOMP_PIN, {0, 0}, false},
			{"SPEAR_KG", "building", "", "attacks", "The spear. It leaves his hoof as a stone of its weight would, and harms by all the energy it flies with, a sharp blow (BLOW_FACTOR in animals.json): at ARM_SPEED half a turkey's health; slower, less, by the square of the speed. The animal is not bowled over, it staggers for SPEAR_STAGGER seconds.", &SPEAR_KG, {0, 0}, false},
			{"FILLING_FREE", "food", "", "mixing", "the share of a filling's water and fat that is free to wet a mix, the rest staying in the pieces; raise it and pieces make a mix wetter", &FILLING_FREE, {0, 0}, false},
			{"MASH_FREE", "food", "", "mixing", "the share of a mashed food's water and fat that is free to wet a dough (a potato or banana mashed into flour); raise it and such a dough is wetter", &MASH_FREE, {0, 0}, false},
			{"FAT_LIQUID", "food", "", "mixing", "free fat counts as this much of its weight in liquid; raise it and butter wets a mix more", &FAT_LIQUID, {0, 0}, false},
			{"CRUMBLY_BELOW", "food", "", "mixing", "A mix's consistency is its free liquid as a share of its weight: under this it is crumbly; raise it and more mixes are crumbs", &CRUMBLY_BELOW, {0, 0}, false},
			{"KNEADABLE_BELOW", "food", "", "mixing", "under this, kneadable (a dough); raise it and wetter mixes are still doughs", &KNEADABLE_BELOW, {0, 0}, false},
			{"POURABLE_BELOW", "food", "", "mixing", "under this pourable (a batter), and over it runny; raise it and wetter mixes are still batters", &POURABLE_BELOW, {0, 0}, false},
			{"FLOUR_LEAST", "food", "", "mixing", "starch from flours (wheat flour, or anything dried and milled: see MILL_WATER_MOST) this share of the weight or more: a mix 'with flour' (crumbs, a dough or a paste, batter, slop); a spice's, a herb's, an egg's or a vegetable's starch is starch, not flour. Raise it and a mix needs more flour to be one", &FLOUR_LEAST, {0, 0}, false},
			{"GLUTEN", "food", "Flour", "mixing", "the share of a food's protein that is gluten: wheat's, which kneaded with water makes the stretchy net that holds a loaf. Wheat flour has it; nothing else in the game does (another grain could have less). Raise it and wheat doughs hold better and want longer kneading", &GLUTEN[.Flour], {0, 0}, false},
			{"GLUTEN_FULL", "food", "", "mixing", "grams of gluten to a gram of flour starch in a bread dough: wheat flour's own, so that wheat is full strength (1) and a mix of flours is in proportion. The best kneading time goes by the gluten against this (MIX_DEVELOP). Raise it and every dough has less strength", &GLUTEN_FULL, {0, 0}, false},
			{"GLUTEN_DOUGH", "food", "", "mixing", "the gluten strength (0 to 1, against GLUTEN_FULL) a kneadable flour mix needs to be a dough that rises; below it, a paste: flat cakes baked, dumplings boiled, and a short mixing time. Raise it and more wheat is needed in a mix of flours to make a dough", &GLUTEN_DOUGH, {0, 1}, true},
			{"GLUTEN_LOAF", "food", "", "mixing", "the gluten strength (0 to 1) under which a loaf comes out dense and crumbly (the flaw Dense, worse the less gluten): half wheat and half potato flour is dense, a little potato flour in wheat is not. Raise it and a loaf needs more wheat to rise", &GLUTEN_LOAF, {0, 1}, true},
			{"MILL_WATER_MOST", "food", "", "mixing", "dried enough to mill: water no more than this share of its weight (wheat flour has 12%). Wetter, it will not mill (\"too wet\"). Raise it and things mill sooner, into a damper flour", &MILL_WATER_MOST, {0, 0.5}, true},
			{"MILL_FAT_MOST", "food", "", "mixing", "fat no more than this share of a dried food's weight to mill: fattier (nuts, cheese) it grinds to a paste, not a flour. Raise it and fattier things mill", &MILL_FAT_MOST, {0, 1}, true},
			{"DRY_TEMP", "food", "", "mixing", "degrees: the low oven that dries a food to mill it without browning it (cut thin, as a dough in strips). Raise it and drying is quicker but browns it", &DRY_TEMP, {0, 0}, false},
			{"PIECES_LEAST", "food", "", "mixing", "things in pieces this share of the weight or more: a mix 'with pieces' (pieces, soup, a pie, muffins); raise it and more pieces are needed", &PIECES_LEAST, {0, 0}, false},
			{"SALAD_LEAST", "food", "", "mixing", "vegetables and fruit, raw and not pressed, this share of the weight or more, without flour: a salad; raise it and a salad must be more nearly all vegetables", &SALAD_LEAST, {0, 0}, false},
			{"BATTER_SET", "food", "", "mixing", "a pourable mix with flour is a batter if protein that sets is this share of its weight, else slop; raise it and a batter needs more egg", &BATTER_SET, {0, 0}, false},
			{"EGG_SET", "food", "", "mixing", "a pourable or runny mix without flour is an egg mix if protein that sets is this share of its weight; raise it and it needs more egg", &EGG_SET, {0, 0}, false},
			{"WASH_OFF", "food", "", "mixing", "washing takes this many powers of ten of microorganisms off what grows in the ground (2: to a hundredth); raise it and washing does more", &WASH_OFF, {0, 0}, false},
			{"SHELL_KEEPS", "food", "", "mixing", "an egg in its shell lets microorganisms grow this share as fast as in the open; raise it and eggs keep less long", &SHELL_KEEPS, {0, 0}, false},
			{"HARD_LEAST", "food", "", "mixing", "what wants cooking (potato, aubergine) this share of the weight or more, eaten raw or not cooked through: hard to digest, a tummy ache; raise it and more of it can be eaten raw", &HARD_LEAST, {0, 0}, false},
			{"MIX_LEAST", "food", "", "mixing", "The best mixing time, in minutes on the dial, is MIX_LEAST, plus MIX_DEVELOP times the share of starch free in it, times (1 - free liquid) to the power MIX_STIFFNESS, times (1 - MIX_RICH times the share of fat and sugar), plus MIX_PER_SET times the setting share. MIX_LEAST is the least, a drink's: raise it and everything wants mixing longer", &MIX_LEAST, {0, 0}, false},
			{"MIX_MOST", "food", "", "mixing", "and never more than this many minutes; raise it and a big stiff dough wants longer", &MIX_MOST, {0, 0}, false},
			{"MIX_DEVELOP", "food", "", "mixing", "minutes for each share of free starch: what makes a flour dough want long mixing; raise it and doughs want longer", &MIX_DEVELOP, {0, 0}, false},
			{"MIX_STIFFNESS", "food", "", "mixing", "how much stiffer, drier mixes want more mixing (a power); raise it and a dry dough wants far longer than a wet one", &MIX_STIFFNESS, {0, 0}, false},
			{"MIX_RICH", "food", "", "mixing", "how much fat and sugar shorten mixing; raise it and a rich batter wants less", &MIX_RICH, {0, 0}, false},
			{"MIX_PER_SET", "food", "", "mixing", "minutes for each share of protein that sets (egg); raise it and egg mixes want longer", &MIX_PER_SET, {0, 0}, false},
			{"MIX_RIGHT_LOW", "food", "", "mixing", "mixed under this share of the best time it is lumpy; it counts as right from here up (for a batter, up to TOUGH_AT). Raise it and less time is forgiven", &MIX_RIGHT_LOW, {0, 0}, false},
			{"MIX_ZERO_LOW", "food", "", "mixing", "mixed under this share of the best time it gets none of the cooking bonus for its mixing; raise it and short mixing costs more", &MIX_ZERO_LOW, {0, 0}, false},
			{"TOUGH_AT", "food", "", "mixing", "a batter mixed over this many times its best is tough; a dough does not mind. Raise it and a batter forgives more", &TOUGH_AT, {0, 0}, false},
			{"TOUGH_ZERO", "food", "", "mixing", "a batter mixed this many times its best gets none of the bonus for its mixing; raise it and overmixing costs less", &TOUGH_ZERO, {0, 0}, false},
			{"TEMP_HOTTEST", "food", "", "mixing", "The best temperature, degrees, is TEMP_HOTTEST, less TEMP_PER_SUGAR times the sugar share and TEMP_PER_SET times the setting share, never under TEMP_LEAST. TEMP_HOTTEST is a plain bread dough's: raise it and everything wants more heat", &TEMP_HOTTEST, {0, 0}, false},
			{"TEMP_LEAST", "food", "", "mixing", "the gentlest best temperature, degrees (an egg mix); raise it and egg mixes want more heat", &TEMP_LEAST, {0, 0}, false},
			{"TEMP_PER_SUGAR", "food", "", "mixing", "degrees less for each whole share of sugar (sugar burns sooner); raise it and sweet things want gentler heat", &TEMP_PER_SUGAR, {0, 0}, false},
			{"TEMP_PER_SET", "food", "", "mixing", "degrees less for each whole share of protein that sets (egg curdles); raise it and egg mixes want gentler heat", &TEMP_PER_SET, {0, 0}, false},
			{"TEMP_RIGHT", "food", "", "mixing", "degrees either side of the best that count as right; raise it and the oven forgives more", &TEMP_RIGHT, {0, 0}, false},
			{"TEMP_FAT_FORGIVES", "food", "", "mixing", "and this many degrees more for each whole share of fat (fat forgives); raise it and rich things forgive more", &TEMP_FAT_FORGIVES, {0, 0}, false},
			{"TEMP_ZERO", "food", "", "mixing", "degrees beyond the right ones at which it gets none of the bonus for its temperature; raise it and a wrong temperature costs less", &TEMP_ZERO, {0, 0}, false},
			{"TIME_PER_KG", "food", "", "mixing", "The best cooking time in the oven, minutes: TIME_PER_KG times the kilograms to the power 2/3, times (1 + TIME_PER_WATER times the water share), times SHAPE_TIME for its shape. On the fire, FIRE_TIME of that. Raise it and everything bakes longer", &TIME_PER_KG, {0, 0}, false},
			{"TIME_PER_WATER", "food", "", "mixing", "how much longer water makes the cooking (water to drive off); raise it and wet things take longer", &TIME_PER_WATER, {0, 0}, false},
			{"FIRE_TIME", "food", "", "mixing", "on the fire a thing is cooked thin: this share of the oven's time; raise it and the fire is slower", &FIRE_TIME, {0, 0}, false},
			{"SHAPE_TIME", "food", "Loaf", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Loaf], {0, 0}, false},
			{"SHAPE_TIME", "food", "Flat", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Flat], {0, 0}, false},
			{"SHAPE_TIME", "food", "Wrapped", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Wrapped], {0, 0}, false},
			{"SHAPE_TIME", "food", "Layered", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Layered], {0, 0}, false},
			{"SHAPE_TIME", "food", "Strips", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Strips], {0, 0}, false},
			{"SHAPE_TIME", "food", "Lumps", "mixing", "the share of a loaf's cooking time a shaped dough takes, oven, fire or pot (a thin shape cooks faster); raise one and that shape takes longer", &SHAPE_TIME[.Lumps], {0, 0}, false},
			{"BOIL_PER_KG", "food", "", "mixing", "The best boiling time in a pot, minutes: BOIL_PER_KG times the kilograms to the power 2/3, times SHAPE_TIME for its shape, and for a drink or a soup BOIL_LIQUID of that. Raise it and everything boils longer", &BOIL_PER_KG, {0, 0}, false},
			{"BOIL_LIQUID", "food", "", "mixing", "a drink or a soup is through in this share of the time (it is all hot water); raise it and liquids boil longer", &BOIL_LIQUID, {0, 0}, false},
			{"BOIL_OFF", "food", "", "mixing", "a drink or a soup boiling loses this share of its water a minute; raise it and it boils down faster", &BOIL_OFF, {0, 0}, false},
			{"BOIL_OFF_MOST", "food", "", "mixing", "but never more than this share of it; raise it and a pot can boil drier", &BOIL_OFF_MOST, {0, 0}, false},
			{"BOIL_ABSORB", "food", "", "mixing", "grams of water starch takes up in the pot for each gram of it, once cooked through (noodles get heavier); raise it and boiled dough comes out heavier", &BOIL_ABSORB, {0, 0}, false},
			{"STARCH_THICKENS", "food", "", "mixing", "grams of water a gram of starch from flour or mash holds as a gel, once cooked through in a pot of liquid: it thickens a soup or a drink (its texture: runny, then soft); 25 g of potato starch thickens a litre into a pourable fruit soup. Raise it and starch thickens more", &STARCH_THICKENS, {0, 0}, false},
			{"BOIL_APART", "food", "", "mixing", "boiled this many times its best it falls apart; raise it and the pot forgives more", &BOIL_APART, {0, 0}, false},
			{"ALCOHOL_OFF", "food", "", "mixing", "the share of what alcohol is left that heat drives off each minute (20 minutes boiling leave a twentieth); raise it and cooking drives it off sooner", &ALCOHOL_OFF, {0, 0}, false},
			{"SPIT_TEMP", "food", "High", "mixing", "the fire's three heights for the spit, each a temperature, degrees: the lower, the hotter. Raise one and that height cooks hotter", &SPIT_TEMP[.High], {0, 0}, false},
			{"SPIT_TEMP", "food", "Middle", "mixing", "the fire's three heights for the spit, each a temperature, degrees: the lower, the hotter. Raise one and that height cooks hotter", &SPIT_TEMP[.Middle], {0, 0}, false},
			{"SPIT_TEMP", "food", "Low", "mixing", "the fire's three heights for the spit, each a temperature, degrees: the lower, the hotter. Raise one and that height cooks hotter", &SPIT_TEMP[.Low], {0, 0}, false},
			{"ROOM_TEMP", "food", "", "mixing", "what a thing starts at, degrees; raise it and it heats through sooner", &ROOM_TEMP, {0, 0}, false},
			{"CORE_DONE", "food", "", "mixing", "The middle is done when it reaches this, degrees. It warms towards the heat around it, never above BOIL while it is wet, and reaches CORE_DONE at the best time at the best temperature. Raise it and the middle needs more heat to count as done", &CORE_DONE, {0, 0}, false},
			{"INSIDE_HEAT_POWER", "food", "", "mixing", "at another temperature the time the middle takes goes with (best - ROOM_TEMP) over (temperature - ROOM_TEMP), to this power; raise it and heat matters more to the time", &INSIDE_HEAT_POWER, {0, 0}, false},
			{"BROWN_DOUBLING", "food", "", "mixing", "The outside browns as the time over the best time, doubled for every BROWN_DOUBLING degrees over the best temperature (halved under): 1 is golden. Raise it and heat burns slower", &BROWN_DOUBLING, {0, 0}, false},
			{"BURNT_CRUST", "food", "", "mixing", "browned this far the crust is burnt; raise it and crusts burn later", &BURNT_CRUST, {0, 0}, false},
			{"CHAR_AT", "food", "Bake", "mixing", "browned this far, with the middle done, the whole thing is charcoal (sooner on an open fire; never in a pot, which says 0); raise it and charcoal comes later", &CHAR_AT[.Bake], {0, 0}, false},
			{"CHAR_AT", "food", "Grill", "mixing", "browned this far, with the middle done, the whole thing is charcoal (sooner on an open fire; never in a pot, which says 0); raise it and charcoal comes later", &CHAR_AT[.Grill], {0, 0}, false},
			{"CHAR_AT", "food", "Boil", "mixing", "browned this far, with the middle done, the whole thing is charcoal (sooner on an open fire; never in a pot, which says 0); raise it and charcoal comes later", &CHAR_AT[.Boil], {0, 0}, false},
			{"DRY_AT_BEST", "food", "", "mixing", "the share of its water a thing loses at its best time and temperature, more the longer and the hotter; raise it and everything dries more", &DRY_AT_BEST, {0, 0}, false},
			{"DRY_RIGHT", "food", "", "mixing", "losing more than this share of its water, it is dry; raise it and more drying is forgiven", &DRY_RIGHT, {0, 0}, false},
			{"BRICK_DRY", "food", "", "mixing", "a dough or a slop that loses this share of its water is a brick; raise it and a brick takes longer", &BRICK_DRY, {0, 0}, false},
			{"CURDLE_OVER", "food", "", "mixing", "an egg mix heated this many degrees over its best curdles; raise it and eggs forgive more heat", &CURDLE_OVER, {0, 0}, false},
			{"SOGGY_LEAFY", "food", "", "mixing", "a salad heated dry whose vegetables are this share leaves or more is a soggy mess; under it, baked or grilled vegetables, the poorer the more leaves. Raise it and more leaves are forgiven", &SOGGY_LEAFY, {0, 0}, false},
			{"UNSAFE_MICROBES", "food", "", "mixing", "Microorganisms are counted per gram as a power of ten. Over this it is unsafe: a tummy ache, the worse the further over. Raise it and more is safe", &UNSAFE_MICROBES, {0, 0}, false},
			{"SPOILED_MICROBES", "food", "", "mixing", "over this it is spoiled for good: it stinks, cooking does not save it, and he will not eat it. Raise it and things take longer to spoil", &SPOILED_MICROBES, {0, 0}, false},
			{"MICROBES_MOST", "food", "", "mixing", "they never grow past this; raise it and there is no other effect", &MICROBES_MOST, {0, 0}, false},
			{"GROW_FASTEST", "food", "", "mixing", "Growth, in powers of ten an hour: GROW_FASTEST at GROW_BEST degrees, nothing at GROW_COLDEST or below, rising as the temperature over GROW_COLDEST to the power GROW_POWER, and falling to nothing at GROW_HOTTEST. Tuned so that grilled meat is safe for 2 days at 24 degrees but not 3, and a week at 4. Raise it and everything goes off sooner", &GROW_FASTEST, {0, 0}, false},
			{"GROW_COLDEST", "food", "", "mixing", "degrees at which they stop growing: frozen, nothing grows; raise it and cold keeps food for good", &GROW_COLDEST, {0, 0}, false},
			{"GROW_BEST", "food", "", "mixing", "degrees at which they grow fastest; raise it and warm places spoil less than hot ones", &GROW_BEST, {0, 0}, false},
			{"GROW_HOTTEST", "food", "", "mixing", "degrees at which they stop growing again (and above which heat starts to kill them); raise it and hot food spoils", &GROW_HOTTEST, {0, 0}, false},
			{"GROW_POWER", "food", "", "mixing", "how much slower the cold is (a power): at 0.71, 4 degrees grows about 0.28 as fast as 24; raise it and the cold keeps things longer", &GROW_POWER, {0, 0}, false},
			{"GROW_DRY", "food", "", "mixing", "growth goes with the water free to them, as a share of the weight: none at this or under; raise it and drier things still keep", &GROW_DRY, {0, 0}, false},
			{"GROW_WET", "food", "", "mixing", "and all of it at this or over; raise it and only the wettest things grow fast", &GROW_WET, {0, 0}, false},
			{"SALT_STOPS", "food", "", "mixing", "Salt, sugar, acid and alcohol each slow growth as their share of the water (salt and water: a brine), to nothing at their own share. Salt stops it at this brine (12%); raise it and salt keeps less", &SALT_STOPS, {0, 0}, false},
			{"SUGAR_STOPS", "food", "", "mixing", "sugar at this share of its water stops it (jam, honey); raise it and sugar keeps less", &SUGAR_STOPS, {0, 0}, false},
			{"ACID_STOPS", "food", "", "mixing", "acid at this share stops it (a pickle's sourness); raise it and sour things keep less", &ACID_STOPS, {0, 0}, false},
			{"ALCOHOL_STOPS", "food", "", "mixing", "alcohol at this share stops it (wine keeps); raise it and alcohol keeps less", &ALCOHOL_STOPS, {0, 0}, false},
			{"KILL_Z", "food", "", "mixing", "degrees for ten times as much killing; raise it and heat over 70 kills less", &KILL_Z, {0, 0}, false},
			{"STAND_STEP", "food", "", "mixing", "hours between one look at a crock and the next, working it out; raise it and standing is worked out more roughly", &STAND_STEP, {0, 0}, false},
			{"SOUR_SALT_LEAST", "food", "", "mixing", "Standing in a crock: in a brine (salt as a share of its water) from SOUR_SALT_LEAST to SOUR_SALT_MOST its sugar sours; under it, what is not a sweet drink rots. Raise it and pickles need more salt", &SOUR_SALT_LEAST, {0, 0}, false},
			{"SOUR_SALT_MOST", "food", "", "mixing", "over this brine nothing sours (and little grows): too salty; raise it and saltier crocks still sour", &SOUR_SALT_MOST, {0, 0}, false},
			{"FERMENT_COLDEST", "food", "", "mixing", "under this many degrees nothing sours or ferments in a crock (its microorganisms are too slow); raise it and a crock wants a warmer place", &FERMENT_COLDEST, {0, 0}, false},
			{"SOUR_RATE", "food", "", "mixing", "how fast the sugar sours: this share of it an hour for each power of ten an hour growth runs at; raise it and pickles are ready sooner", &SOUR_RATE, {0, 0}, false},
			{"ACID_PER_SUGAR", "food", "", "mixing", "grams of acid from a gram of sugar, souring; raise it and pickles get sourer", &ACID_PER_SUGAR, {0, 0}, false},
			{"ACID_KCAL", "food", "", "mixing", "calories in a gram of acid; raise it and sour things are richer", &ACID_KCAL, {0, 0}, false},
			{"YEAST_RATE", "food", "", "mixing", "a sweet drink without salt: this share of its sugar turns to alcohol an hour for each power of ten an hour growth runs at; raise it and wine is ready sooner", &YEAST_RATE, {0, 0}, false},
			{"ALCOHOL_PER_SUGAR", "food", "", "mixing", "grams of alcohol from a gram of sugar (the rest goes off as gas); raise it and wine is stronger", &ALCOHOL_PER_SUGAR, {0, 0}, false},
			{"ALCOHOL_KCAL", "food", "", "mixing", "calories in a gram of alcohol; raise it and wine is richer", &ALCOHOL_KCAL, {0, 0}, false},
			{"ALCOHOL_YEAST_MOST", "food", "", "mixing", "the yeast stops when alcohol is this share of its water; raise it and wine can get stronger", &ALCOHOL_YEAST_MOST, {0, 0}, false},
			{"VINEGAR_RATE", "food", "", "mixing", "with air: this share of the alcohol turns to acid an hour for each power of ten an hour growth runs at; raise it and vinegar comes sooner", &VINEGAR_RATE, {0, 0}, false},
			{"ACID_PER_ALCOHOL", "food", "", "mixing", "grams of acid from a gram of alcohol (it takes oxygen from the air); raise it and vinegar gets sourer", &ACID_PER_ALCOHOL, {0, 0}, false},
			{"WATER_PER_ALCOHOL", "food", "", "mixing", "and grams of water with it; raise it and vinegar comes out heavier", &WATER_PER_ALCOHOL, {0, 0}, false},
			{"PICKLED_ACID", "food", "", "mixing", "soured to this share of acid it is pickles; raise it and pickles take longer", &PICKLED_ACID, {0, 0}, false},
			{"WINE_ALCOHOL", "food", "", "mixing", "with this share of alcohol it is wine; raise it and wine must be stronger", &WINE_ALCOHOL, {0, 0}, false},
			{"VINEGAR_ACID", "food", "", "mixing", "turned to this share of acid, with little alcohol left, it is vinegar; raise it and vinegar takes longer", &VINEGAR_ACID, {0, 0}, false},
			{"TASTE_PLAIN", "food", "", "mixing", "Taste runs from -1 (awful) to 1: TASTE_PLAIN, plus for each taste its gain as far as its best share, less its loss for every share over its most; less the flaws. Raise it and everything tastes better", &TASTE_PLAIN, {0, 0}, false},
			{"BURN_BITTER", "food", "", "mixing", "bitterness a burnt outside adds for each step browned past golden; raise it and burnt things taste worse", &BURN_BITTER, {0, 0}, false},
			{"TASTE_FLAWS", "food", "Lumpy", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Lumpy], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Tough", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Tough], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Raw_Middle", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Raw_Middle], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Burnt_Crust", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Burnt_Crust], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Curdled", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Curdled], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Dry", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Dry], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Soggy", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Soggy], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Falls_Apart", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Falls_Apart], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Hard_To_Digest", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Hard_To_Digest], {0, 0}, false},
			{"TASTE_FLAWS", "food", "Dense", "mixing", "what each flaw takes off the taste (soggy, by the share of leaves); raise one and that flaw tastes worse", &TASTE_FLAWS[.Dense], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Lumpy", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Lumpy], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Tough", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Tough], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Raw_Middle", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Raw_Middle], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Burnt_Crust", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Burnt_Crust], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Curdled", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Curdled], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Dry", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Dry], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Soggy", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Soggy], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Falls_Apart", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Falls_Apart], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Hard_To_Digest", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Hard_To_Digest], {0, 0}, false},
			{"CONSISTENCY_FLAWS", "food", "Dense", "mixing", "what each flaw takes off how right its consistency is (from 1; dense, by how little gluten there is against GLUTEN_LOAF); raise one and that flaw spoils the texture more", &CONSISTENCY_FLAWS[.Dense], {0, 0}, false},
			{"TEXTURE_WATER", "food", "Runny", "mixing", "a dish is runny with more than this share of water (unless it set: SET_FIRM of setting protein, and cooked), soft, firm or hard over these, and brittle under; raise one and that texture needs more water", &TEXTURE_WATER[.Runny], {0, 0}, false},
			{"TEXTURE_WATER", "food", "Soft", "mixing", "a dish is runny with more than this share of water (unless it set: SET_FIRM of setting protein, and cooked), soft, firm or hard over these, and brittle under; raise one and that texture needs more water", &TEXTURE_WATER[.Soft], {0, 0}, false},
			{"TEXTURE_WATER", "food", "Firm", "mixing", "a dish is runny with more than this share of water (unless it set: SET_FIRM of setting protein, and cooked), soft, firm or hard over these, and brittle under; raise one and that texture needs more water", &TEXTURE_WATER[.Firm], {0, 0}, false},
			{"TEXTURE_WATER", "food", "Hard", "mixing", "a dish is runny with more than this share of water (unless it set: SET_FIRM of setting protein, and cooked), soft, firm or hard over these, and brittle under; raise one and that texture needs more water", &TEXTURE_WATER[.Hard], {0, 0}, false},
			{"TEXTURE_WATER", "food", "Brittle", "mixing", "a dish is runny with more than this share of water (unless it set: SET_FIRM of setting protein, and cooked), soft, firm or hard over these, and brittle under; raise one and that texture needs more water", &TEXTURE_WATER[.Brittle], {0, 0}, false},
			{"TEXTURE_PIECES", "food", "", "mixing", "for its texture, what is in pieces counts this share of its water (a cut of meat is not runny); raise it and dishes of pieces are softer", &TEXTURE_PIECES, {0, 0}, false},
			{"SET_FIRM", "food", "", "mixing", "protein that sets this share of the weight, cooked, holds a wet dish firm; raise it and more egg is needed", &SET_FIRM, {0, 0}, false},
			{"HARD_WET", "food", "", "mixing", "Hardness, 0 to 1: none with this share of water or more; raise it and wetter things are hard", &HARD_WET, {0, 0}, false},
			{"HARD_DRY", "food", "", "mixing", "all of it at this share of water or less (a brick comes out about 0.8); raise it and hardness comes sooner", &HARD_DRY, {0, 0}, false},
			{"SKILL_WIDE", "food", "Mixing", "mixing", "The editor's interval for each setting is this many times the best value wide for a beginner, narrowing to SKILL_NARROW for a master; raise one and a beginner is told less", &SKILL_WIDE[.Mixing], {0, 0}, false},
			{"SKILL_WIDE", "food", "Cooking", "mixing", "The editor's interval for each setting is this many times the best value wide for a beginner, narrowing to SKILL_NARROW for a master; raise one and a beginner is told less", &SKILL_WIDE[.Cooking], {0, 0}, false},
			{"SKILL_WIDE", "food", "Temperature", "mixing", "The editor's interval for each setting is this many times the best value wide for a beginner, narrowing to SKILL_NARROW for a master; raise one and a beginner is told less", &SKILL_WIDE[.Temperature], {0, 0}, false},
			{"SKILL_NARROW", "food", "Mixing", "mixing", "a master's interval, as many times the best value; raise one and a master is told less", &SKILL_NARROW[.Mixing], {0, 0}, false},
			{"SKILL_NARROW", "food", "Cooking", "mixing", "a master's interval, as many times the best value; raise one and a master is told less", &SKILL_NARROW[.Cooking], {0, 0}, false},
			{"SKILL_NARROW", "food", "Temperature", "mixing", "a master's interval, as many times the best value; raise one and a master is told less", &SKILL_NARROW[.Temperature], {0, 0}, false},
			{"SKILL_NOT_MIDDLE", "food", "", "mixing", "and never within this share of the middle (or the middle would give it away); raise it and the best is further from the middle", &SKILL_NOT_MIDDLE, {0, 0}, false},
			{"WOOD_PER_HOUR", "food", "", "mixing", "logs an hour of cooking at WOOD_AT degrees burns, more or less in proportion to the heat over ROOM_TEMP; raise it and cooking burns more wood", &WOOD_PER_HOUR, {0, 0}, false},
			{"WOOD_AT", "food", "", "mixing", "the degrees WOOD_PER_HOUR is counted at; raise it and hot cooking burns less", &WOOD_AT, {0, 0}, false},
			{"THROW_ENERGY", "handling", "", "attacks", "Rocks and stones: his arms put the same energy into every throw, THROW_ENERGY joules for each kilogram of him (times the strength of his arms), so the speed is the square root of twice that over the stone's weight. A heavy rock is a short, slow lob; a light stone would fly faster than an arm can move, and leaves at ARM_SPEED (times the root of his strength) at the most.", &THROW_ENERGY, {0, 0}, false},
			{"ARM_SPEED", "handling", "", "attacks", "the fastest a stone or a spear leaves his hoof, m/s, for arms of ordinary strength", &ARM_SPEED, {0, 0}, false},
			{"ANIMAL_THROW_GAIN", "handling", "", "attacks", "for animals, which he can wind up", &ANIMAL_THROW_GAIN, {0, 0}, false},
			{"MAX_THROW", "handling", "", "attacks", "the fastest anything he throws or swings can go, m/s", &MAX_THROW, {0, 0}, false},
			{"ARM_LIFT", "handling", "", "attacks", "kg of rock he can lift for each kg of his arm muscle: an ordinary Prosio (5 kg of arm muscle) 40 kg, the strongest arms (12 kg) 96 kg, arms wasted away (3 kg) 24 kg. A rock heavier than that stays on the ground (\"Way too heavy to lift!\"). Raise it and he lifts heavier rocks", &ARM_LIFT, {0, 0}, false},
			{"HEAVE_TIME", "handling", "", "attacks", "seconds to heave up a rock at the most he can lift; a lighter one in proportion (a 10 kg rock, for an ordinary Prosio, half a second)", &HEAVE_TIME, {0, 0}, false},
			{"HEAVE_COST", "handling", "", "attacks", "stamina to heave up a rock at the most he can lift, on top of 6 for any; a lighter one in proportion. Held, a rock also weighs on him the more the nearer it is to his limit: at it, as much again as it weighs", &HEAVE_COST, {0, 0}, false},
			{"CLUB_SHARE", "handling", "", "attacks", "A held animal slammed into the ground or anything solid harms itself by the energy of the part of its body behind the blow (CLUB_SHARE of its weight) at the speed it hit, a soft blow. Whatever the swung animal hits takes a share of its speed set by their weights, as when two balls collide. But the club is floppy: only part of its body (CLUB_SHARE of its weight) is behind the blow, and it squashes rather than bounces (restitution BASH_BOUNCE). For a club of weight m moving at v, striking something of weight M: it flies off at   (1 + e) * m' / (m' + M) * v,   with m' = CLUB_SHARE * m the club goes on  (m' - e * M) / (m' + M) * v So a turkey swung into a turkey knocks it about half as fast as it was swung, and swung into the billy goat it barely rocks it and bounces back.", &CLUB_SHARE, {0, 0}, false},
			{"JUMP_ENERGY", "prosio", "", "attacks", "Ordinary legs put the same energy into every jump, so height = energy / weight: a 40 kg Prosio jumps 0.9 high, a 120 kg Prosio only 0.3. Strong legs put in more (see LEG_SPRING in the skills section).", &JUMP_ENERGY, {0, 0}, false},
			{"LEG_SPRING", "prosio", "", "attacks", "and how much more goes into a jump;", &LEG_SPRING, {0, 0}, false},
			{"WEAK_LEGS", "prosio", "", "attacks", "both, with legs wasted away", &WEAK_LEGS, {0, 0}, false},
		}
		return list[:]
	}
}
